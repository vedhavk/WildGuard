# ==============================================================================
# WILD GUARD BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# LOCAL DEVELOPMENT (PostgreSQL):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_NAME=wild

# PRODUCTION (Neon PostgreSQL):
# If DATABASE_URL is set, it overrides the individual DB_* variables above.
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# AI VISION (ROBOFLOW):
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_MODEL_ID=wild-animal-x055y/1

# EMAIL NOTIFICATIONS (SMTP):
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SECURITY & AUTH (JWT):
JWT_SECRET=your_secure_random_jwt_secret_key
